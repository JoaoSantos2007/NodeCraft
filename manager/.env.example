# App
# PORT — HTTP port the manager listens on (default 9183)
# STAGE — set to DEV for local development; anything else (or unset) means production.
# GMT — hour offset applied to scheduled jobs (the nightly backup runs at 3AM local time)
PORT=9183
STAGE=PROD
GMT=-3

# Frontend URLs
# SITE_URL — base URL of the web frontend (default http://localhost:3030)
# CORS_ORIGIN — comma-separated allowed origins, exact match, no wildcards (default SITE_URL)
SITE_URL=
CORS_ORIGIN=

# Database
# DATABASE_ENABLE — must be the literal string "true" to use MySQL;
# DATABASE_POOL_MAX — max connections in the Sequelize pool (default 20)
# DATABASE_POOL_ACQUIRE — ms to wait for a free connection before failing (default 20000)
# DATABASE_LOCK_WAIT_TIMEOUT — innodb_lock_wait_timeout, in SECONDS (default 10)
DATABASE_ENABLE=
DATABASE_HOST=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_POOL_MAX=
DATABASE_POOL_ACQUIRE=
DATABASE_LOCK_WAIT_TIMEOUT=

# Email (account verification and password reset)
# EMAIL_ENABLE / EMAIL_SECURE — must be the literal string "true" to enable
EMAIL_ENABLE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=

# Auth
# JWT_SECRET — secret used to sign access tokens.
JWT_SECRET=

# Instances
# MAX_HISTORY — status lines kept per instance; older ones are dropped (default 50)
# MIN_PORT / MAX_PORT — host port range allocated to instances (default 5621–5671)
MAX_HISTORY=50
MIN_PORT=5621
MAX_PORT=5671

# External resolvers (roster identity lookup)
STEAM_API_KEY=
