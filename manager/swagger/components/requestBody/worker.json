{
  "create": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 32,
              "example": "worker-sp-01"
            }
          }
        }
      }
    }
  },
  "update": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 32,
              "example": "worker-sp-01"
            },
            "url": {
              "type": "string",
              "example": "http://worker.webisk.com.br:9184"
            },
            "secret": {
              "type": "string",
              "description": "Replaces the shared secret the manager uses to authenticate against this worker. Write-only: it is never returned by any endpoint after creation, so send it only to rotate. An empty or blank string, or omitting the field, leaves the current secret unchanged. Rotating it here requires setting the same value as MANAGER_SECRET on the worker.",
              "example": "eea07ccc96ed4bade91405eb9f68922b5e431eee0fbc4d0aaa82b25f4d97e723"
            }
          }
        }
      }
    }
  },
  "heartbeat": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "cpuUsage": {
              "type": "number",
              "example": 23.5
            },
            "memoryTotal": {
              "type": "integer",
              "example": 16384
            },
            "memoryUsed": {
              "type": "integer",
              "example": 4096
            },
            "diskAvailable": {
              "type": "integer",
              "example": 204800
            }
          }
        }
      }
    }
  },
  "updateInstance": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "running",
                "stopped",
                "failed"
              ],
              "example": "running"
            },
            "history": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "New console/log lines appended to the instance history.",
              "example": [
                "[03:00:00] Server started"
              ]
            },
            "diskUsage": {
              "type": "integer",
              "description": "Current disk usage of the instance in MB.",
              "example": 512
            }
          }
        }
      }
    }
  },
  "backup": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failed",
                "skipped"
              ],
              "example": "success"
            }
          }
        }
      }
    }
  }
}
