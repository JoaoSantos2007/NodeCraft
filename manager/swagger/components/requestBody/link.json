{
  "create": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "userId"
          ],
          "properties": {
            "userId": {
              "type": "string",
              "example": "1e7ca2e6-519d-45af-ba5f-18305979ac8b"
            },
            "permissions": {
              "type": "array",
              "example": [
                "instance:read",
                "instance:execute"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "instance:read",
                  "instance:edit",
                  "instance:execute",
                  "instance:backup",
                  "instance:console:read",
                  "instance:console:write",
                  "instance:files:read",
                  "instance:files:write",
                  "instance:files:edit",
                  "instance:roster:edit"
                ]
              },
              "description": "Instance permissions granted to the linked account. Only the values listed here are accepted; instance:owner is not grantable."
            }
          }
        }
      }
    }
  },
  "update": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "properties": {
            "permissions": {
              "type": "array",
              "example": [
                "instance:read",
                "instance:execute"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "instance:read",
                  "instance:edit",
                  "instance:execute",
                  "instance:backup",
                  "instance:console:read",
                  "instance:console:write",
                  "instance:files:read",
                  "instance:files:write",
                  "instance:files:edit",
                  "instance:roster:edit"
                ]
              },
              "description": "Instance permissions granted to the linked account. Only the values listed here are accepted; instance:owner is not grantable."
            }
          }
        }
      }
    }
  }
}
