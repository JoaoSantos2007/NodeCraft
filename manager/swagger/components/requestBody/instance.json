{
  "owner": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "ownerId"
          ],
          "properties": {
            "ownerId": {
              "type": "string",
              "format": "uuid",
              "example": "1e7ca2e6-519d-45af-ba5f-18305979ac8b"
            }
          }
        }
      }
    }
  },
  "worker": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "workerId"
          ],
          "properties": {
            "workerId": {
              "type": "string",
              "format": "uuid",
              "nullable": true,
              "example": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f"
            }
          }
        }
      }
    }
  },
  "create": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "description": "Creates an instance. `workerId` is mandatory \u2014 there is no automatic placement \u2014 and must be one of the user's `allowedWorkers`. `game` must match `type`; sending a `game` block for a different game is rejected. `port`, `status` and `history` are server-assigned and rejected if sent.",
          "required": [
            "name",
            "type",
            "workerId",
            "game"
          ],
          "properties": {
            "name": {
              "type": "string",
              "example": "Meu mundo de minecraft",
              "minLength": 3,
              "maxLength": 32
            },
            "type": {
              "type": "string",
              "enum": [
                "minecraft",
                "hytale",
                "terraria",
                "kerbal"
              ],
              "example": "minecraft"
            },
            "workerId": {
              "type": "string",
              "description": "Worker to place the instance on. Must be one of the user's allowedWorkers.",
              "example": "0c9f3d2a-1b4e-4c8a-9f7d-2e5a6b8c1d3f",
              "format": "uuid"
            },
            "memory": {
              "type": "integer",
              "minimum": 512,
              "example": 2048
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "example": 2
            },
            "maxPlayers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "example": 10
            },
            "game": {
              "oneOf": [
                {
                  "$ref": "../schemas/minecraft.json"
                },
                {
                  "$ref": "../schemas/hytale.json"
                },
                {
                  "$ref": "../schemas/kerbal.json"
                },
                {
                  "$ref": "../schemas/terraria.json"
                }
              ]
            }
          }
        }
      }
    }
  },
  "update": {
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "description": "Updates an existing instance. Every property is optional, but `game` may only be sent together with `type` (it is validated against it), and sending `type` requires `game`. `type` itself is not persisted \u2014 it only selects which `game` schema applies. `workerId` cannot be changed here; use `PUT /instance/{id}/worker` (admin). The instance must be stopped.",
          "properties": {
            "name": {
              "type": "string",
              "example": "Meu mundo de minecraft",
              "minLength": 3,
              "maxLength": 32
            },
            "type": {
              "type": "string",
              "enum": [
                "minecraft",
                "hytale",
                "terraria",
                "kerbal"
              ],
              "example": "minecraft",
              "description": "Selects which game schema validates `game`. Not persisted \u2014 the game of an instance cannot be changed."
            },
            "memory": {
              "type": "integer",
              "minimum": 512,
              "example": 2048
            },
            "cpu": {
              "type": "integer",
              "minimum": 1,
              "example": 2
            },
            "maxPlayers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "example": 10
            },
            "game": {
              "oneOf": [
                {
                  "$ref": "../schemas/minecraft.json"
                },
                {
                  "$ref": "../schemas/hytale.json"
                },
                {
                  "$ref": "../schemas/kerbal.json"
                },
                {
                  "$ref": "../schemas/terraria.json"
                }
              ],
              "description": "Game-specific settings. Optional: an update may change only instance fields. When sent, `type` must be sent too (it selects which game schema applies and is not persisted)."
            }
          }
        }
      }
    }
  }
}
