{
  "post": {
    "summary": "refresh User access token",
    "description": "Rotates the session using the `refreshToken` cookie: issues a fresh access token (and refresh token) as httpOnly cookies. Returns 401 if the refresh token is missing, expired or invalid.",
    "tags": [
      "Auth"
    ],
    "security": [
      {
        "refreshCookie": []
      }
    ],
    "responses": {
      "200": {
        "$ref": "../../components/responses/user.json#/default"
      },
      "401": {
        "$ref": "../../components/responses/error.json#/Unathorized"
      },
      "429": {
        "$ref": "../../components/responses/error.json#/TooManyRequests"
      },
      "500": {
        "$ref": "../../components/responses/error.json#/Internal"
      }
    }
  }
}
