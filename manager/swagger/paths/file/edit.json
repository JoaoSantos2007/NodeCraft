{
  "put": {
    "summary": "update File",
    "description": "Overwrites the content of an existing file at `path`. Proxied to the worker. Requires `instance:files:edit`.",
    "tags": [
      "Files"
    ],
    "parameters": [
      {
        "name": "path",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "eula.txt"
      }
    ],
    "responses": {
      "200": {
        "$ref": "../../components/responses/file.json#/edit"
      },
      "400": {
        "$ref": "../../components/responses/error.json#/InvalidRequest"
      },
      "401": {
        "$ref": "../../components/responses/error.json#/Unathorized"
      },
      "403": {
        "$ref": "../../components/responses/error.json#/Forbidden"
      },
      "404": {
        "$ref": "../../components/responses/error.json#/NotFound"
      },
      "413": {
        "$ref": "../../components/responses/error.json#/PayloadTooLarge"
      },
      "500": {
        "$ref": "../../components/responses/error.json#/Internal"
      },
      "503": {
        "$ref": "../../components/responses/error.json#/UnavailableService"
      }
    },
    "requestBody": {
      "$ref": "../../components/requestBody/file.json#/edit"
    }
  },
  "parameters": [
    {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      },
      "example": "76ad39e5-827f-4e0f-9715-e590be710595"
    }
  ]
}
