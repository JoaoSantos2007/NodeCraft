PORT=9184
STAGE=DEV
WORKER_ID=

# pino level: trace|debug|info|warn|error|fatal|silent (default info).
# Logs go to stdout as JSON; systemd captures them into journald.
LOG_LEVEL=

# File API limits, in MiB. Upload and copy/extract growth also obey the
# owner's remaining disk allowance sent by the manager.
FILE_MAX_UPLOAD_MB=2048
FILE_MAX_OPERATION_MB=2048
FILE_MIN_FREE_MB=512
FILE_MAX_PREVIEW_MB=1
FILE_MAX_DIRECTORY_ENTRIES=1000
FILE_MAX_ARCHIVE_ENTRIES=10000
FILE_MAX_CONCURRENT_READS=4

# Ordinary JSON request bodies, in KiB (multipart uploads have their own limit).
HTTP_JSON_KB=100

# Pending console history per instance; oldest lines are dropped at either cap.
# Line length is measured in JS characters; history size includes JSON escaping.
# Manager WORKER_REPORT_MAX_MB must exceed CONSOLE_MAX_HISTORY_MB for metadata.
CONSOLE_MAX_PENDING_LINES=20000
CONSOLE_MAX_LINE_CHARS=1048576
CONSOLE_MAX_HISTORY_MB=8

# Local ZIP limit in MiB. Backups run one at a time and preserve FILE_MIN_FREE_MB
BACKUP_MAX_MB=10240
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4

MANAGER_URL=
MANAGER_API_KEY=
MANAGER_SECRET=

STORAGE_ENABLE=true
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATHSTYLE=
STORAGE_ID=
STORAGE_SECRET=

PUID=
PGID=
